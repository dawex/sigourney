        "description": "This endpoint checks the given OpenCorporates Tax ID against the OpenCorporates API and responds with \n    a verifiable credential attesting the tax ID's validity as a registration number",
        "parameters": [
          {
            "name": "vcId",
            "required": true,
            "in": "query",
